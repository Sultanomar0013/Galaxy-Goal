# Copy to .env and fill in.
# mysql://USER:PASSWORD@HOST:PORT/DATABASE  (XAMPP default: root with an empty password)
DATABASE_URL="mysql://root:@localhost:3306/my_goals"

# Super admin created/updated by `npm run db:seed`
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please"

# Email (verification codes). Leave SMTP_HOST empty in dev to print codes to the console instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password>
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Goal Galaxy <you@example.com>"

# Link used in emails (connect requests)
APP_URL="http://localhost:3000"

# Web push notifications. Generate with: npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: address or an https URL you control.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
